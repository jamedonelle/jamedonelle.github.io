---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'My personal site: writing, books, and music.' } = Astro.props;

// BASE_URL respects the `base` option, so links keep working on a GitHub project site.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const nav = [
  { href: `${base}/blog/`, label: 'Blog' },
  { href: `${base}/books/`, label: 'Books' },
  { href: `${base}/music/`, label: 'Music' },
];
const fullTitle = title === 'Home' ? 'James Donelle' : `${title} · James Donelle`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="alternate" type="application/rss+xml" title="Blog" href={`${base}/rss.xml`} />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={`${base}/`}>James Donelle</a>
        <nav>
          {nav.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">© {new Date().getFullYear()} James Donelle</div>
    </footer>
  </body>
</html>
