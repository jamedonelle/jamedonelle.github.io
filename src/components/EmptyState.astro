---
import PixelComputer from './PixelComputer.astro';
import PixelBook from './PixelBook.astro';
import PixelRecordPlayer from './PixelRecordPlayer.astro';

interface Props {
  what: string;
  variant: 'blog' | 'books' | 'music';
}
const { what, variant } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="empty">
  {variant === 'blog' && <PixelComputer />}
  {variant === 'books' && <PixelBook />}
  {variant === 'music' && <PixelRecordPlayer />}
  <p class="empty-title">Nothing to see here.</p>
  <p class="empty-sub">No {what} yet. Check back soon.</p>
  <a class="empty-link" href={`${base}/`}>Back home</a>
</div>
