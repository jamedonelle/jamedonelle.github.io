---
interface Props {
  scale?: number;
}
const { scale = 8 } = Astro.props;
---

<canvas
  class="pixel-art pixel-player"
  width="22"
  height="20"
  style={`width:${22 * scale}px`}
  aria-hidden="true"></canvas>

<script>
  import { line, px } from '../scripts/pixel';

  const W = 22;
  const H = 20;
  const OY = 6; // the deck is drawn below a strip reserved for floating notes
  const TAU = Math.PI * 2;
  const note = ['.##', '.#.', '.#.', '##.'];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Tonearm positions in deck coordinates: head parked off the record, and resting on it.
  const rest = { x: 19, y: 10 };
  const play = { x: 11, y: 6 };
  const pivot = { x: 18, y: 2 };
  const labelPixels = [
    [5, 5],
    [6, 5],
    [6, 6],
    [5, 6],
  ];

  document.querySelectorAll<HTMLCanvasElement>('canvas.pixel-player').forEach((canvas) => {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let playing = !reduce;
    let t = playing ? 1 : 0; // 0 = arm parked, 1 = arm on record
    let angle = 0;
    let tick = 0;
    let notes: { x: number; y: number }[] = [];

    const draw = () => {
      ctx.clearRect(0, 0, W, H);

      // Deck
      px(ctx, 0, OY, '#7a4a2e', 22, 14);
      px(ctx, 1, OY + 1, '#9a6a42', 20, 12);

      // Record, with two light wedges that rotate so the spin is visible
      for (let y = 1; y <= 12; y++) {
        for (let x = 1; x <= 12; x++) {
          const dx = x + 0.5 - 7;
          const dy = y + 0.5 - 7;
          const r = Math.hypot(dx, dy);
          if (r > 5.9) continue;
          let color = '#1c1c1e';
          if (r <= 2.2) color = '#c2410c';
          else if (r > 2.7) {
            const d = (((Math.atan2(dy, dx) - angle) % Math.PI) + Math.PI) % Math.PI;
            if (d < 0.4) color = '#4a4a50';
          }
          px(ctx, x, OY + y, color);
        }
      }
      // A marker on the label shows the spin too.
      const quarter = Math.floor((((angle % TAU) + TAU) % TAU) / (Math.PI / 2)) % 4;
      const [mx, my] = labelPixels[quarter];
      px(ctx, mx, OY + my, '#f59e0b');

      // Tonearm
      const hx = rest.x + (play.x - rest.x) * t;
      const hy = rest.y + (play.y - rest.y) * t;
      px(ctx, pivot.x - 1, OY + pivot.y - 1, '#2b3526', 3, 3);
      line(ctx, pivot.x, OY + pivot.y, hx, OY + hy, '#d8d3c4');
      px(ctx, Math.round(hx), OY + Math.round(hy), '#2b3526');

      // Status light
      px(ctx, 15, OY + 11, playing ? '#4fbf5f' : '#b91c1c');

      // Floating notes
      notes.forEach((n) =>
        note.forEach((row, ry) =>
          [...row].forEach((ch, rx) => {
            if (ch === '#') px(ctx, n.x + rx, n.y + ry, '#2f4a2a');
          }),
        ),
      );
    };

    const step = () => {
      tick++;
      t = playing ? Math.min(1, t + 0.12) : Math.max(0, t - 0.12);
      angle += 0.35 * t;
      if (playing && t >= 1 && tick % 14 === 0) {
        notes.push({ x: 3 + Math.floor(Math.random() * 16), y: 5 });
      }
      if (tick % 3 === 0) notes.forEach((n) => n.y--);
      notes = notes.filter((n) => n.y > -4);
      draw();
    };

    // Click or tap to play / pause.
    canvas.addEventListener('pointerdown', () => (playing = !playing));
    draw();
    window.setInterval(step, 80);
  });
</script>
