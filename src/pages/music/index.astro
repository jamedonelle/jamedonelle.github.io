---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EmptyState from '../../components/EmptyState.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entries = (await getCollection('music')).sort((a, b) =>
  a.data.artist.localeCompare(b.data.artist),
);
const stars = (n?: number) => (n ? '★'.repeat(n) + '☆'.repeat(5 - n) : '');
---

<Base title="Music">
  <h1>Music</h1>
  {entries.length === 0 && <EmptyState what="music" variant="music" />}
  <ul class="list">
    {entries.map((m) => (
      <li>
        <h3><a href={`${base}/music/${m.id}/`}>{m.data.title}</a></h3>
        <span class="meta">
          {m.data.artist}{m.data.year ? ` · ${m.data.year}` : ''} · {m.data.kind}
          {m.data.rating ? ` · ${stars(m.data.rating)}` : ''}
        </span>
      </li>
    ))}
  </ul>
</Base>
