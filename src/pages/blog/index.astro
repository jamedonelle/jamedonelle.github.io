---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EmptyState from '../../components/EmptyState.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base title="Blog">
  <h1>Blog</h1>
  {posts.length === 0 && <EmptyState what="posts" variant="blog" />}
  <ul class="list">
    {posts.map((p) => (
      <li>
        <h3><a href={`${base}/blog/${p.id}/`}>{p.data.title}</a></h3>
        <span class="meta">{p.data.pubDate.toLocaleDateString('en-US', { dateStyle: 'long' })}</span>
        <p>{p.data.description}</p>
        <div>{p.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
      </li>
    ))}
  </ul>
</Base>
